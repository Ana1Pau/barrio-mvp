# Copia este archivo a .env y reemplaza cada valor localmente.
# No compartas ni subas database/docker/.env.
MSSQL_SA_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL_LARGO
BARRIO_API_DB_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_LOCAL_DE_32_CARACTERES
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS

# La API usa datos persistentes, pero no contacta a Pey ni cobra en este modo.
PAYMENTS_MODE=simulated
PEY_LIVE_CHARGES_ENABLED=false
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:8081
